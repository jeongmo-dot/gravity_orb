[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/position_steps=4
jolt_physics_3d/simulation/penetration_slop=0.02
jolt_physics_3d/simulation/baumgarte_stabilization_factor=0.2
2d/solver/contact_max_allowed_penetration=0.1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[threading]

worker_pool/max_threads=1
